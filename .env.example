# ─── Backend ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:dev@localhost/blogstudio

# Redis connection string
REDIS_URL=redis://localhost:6379

# JWT — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# CORS: comma-separated list of allowed origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:3000"]

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
