# Application
APP_NAME=AI Blog Studio
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:dev@localhost:5432/blogstudio

# Redis
REDIS_URL=redis://localhost:6379

# Authentication — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# AI Rate Limiting
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=3600

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
